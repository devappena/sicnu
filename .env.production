# Configuration de l'environnement de PRODUCTION

# URL de l'API Backend (à configurer selon votre serveur)
VITE_API_BASE_URL=https://api.ena-rh.cd/api

# Mode de production
VITE_APP_ENV=production

# Désactiver les logs en production
VITE_ENABLE_API_LOGGING=false

# Timeout des requêtes (en millisecondes)
VITE_API_TIMEOUT=30000

# Désactiver React Query DevTools en production
VITE_ENABLE_REACT_QUERY_DEVTOOLS=false

# Configuration JWT
VITE_TOKEN_STORAGE_KEY=ena-auth-token
VITE_REFRESH_TOKEN_KEY=ena-refresh-token

# URLs des services externes (si nécessaire)
# VITE_STORAGE_URL=https://storage.ena-rh.cd
# VITE_WEBSOCKET_URL=wss://api.ena-rh.cd
