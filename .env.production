# Configuration de l'environnement de PRODUCTION

# Même origine que le frontend Vercel (fonction serverless /api)
VITE_API_BASE_URL=/api

# Mode de production
VITE_APP_ENV=production

# Désactiver les logs en production
VITE_ENABLE_API_LOGGING=false

# Timeout des requêtes (en millisecondes)
VITE_API_TIMEOUT=30000

# Désactiver React Query DevTools en production
VITE_ENABLE_REACT_QUERY_DEVTOOLS=false

# Configuration JWT
VITE_TOKEN_STORAGE_KEY=sicnu-auth-token
VITE_REFRESH_TOKEN_KEY=sicnu-refresh-token

# URLs des services externes (si nécessaire)
# VITE_STORAGE_URL=
# VITE_WEBSOCKET_URL=
