# Variables d'environnement - Template
# ====================
# INSTRUCTIONS D'UTILISATION
# ====================
# 1. Copier ce fichier en .env.development ou .env.production
# 2. Remplir avec vos valeurs réelles
# 3. NE JAMAIS committer les fichiers .env contenant des valeurs sensibles

# ====================
# Configuration API
# ====================
# URL de l'API backend
# Développement: http://localhost:3000/api
# Production: https://api.ena-rh.cd/api
VITE_API_BASE_URL=http://localhost:3000/api

# Environnement (development | staging | production)
VITE_APP_ENV=development

# Délai de timeout des requêtes API en millisecondes
VITE_API_TIMEOUT=30000

# Activer les logs de l'API (requêtes/réponses) - true/false
VITE_ENABLE_API_LOGGING=true

# ====================
# Configuration Authentication
# ====================
# Clés de stockage des tokens dans localStorage
VITE_TOKEN_STORAGE_KEY=ena-auth-token
VITE_REFRESH_TOKEN_KEY=ena-refresh-token

# Durée de validité du token (ms) - 1 heure = 3600000
VITE_TOKEN_EXPIRATION=3600000

# ====================
# Configuration React Query
# ====================
# Activer les DevTools React Query (uniquement en développement) - true/false
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true

# Temps avant qu'une donnée soit considérée comme périmée (ms) - 1 minute = 60000
VITE_QUERY_STALE_TIME=60000

# Temps de conservation en cache (ms) - 5 minutes = 300000
VITE_QUERY_CACHE_TIME=300000

# Réactualiser au focus de la fenêtre - true/false
VITE_REFETCH_ON_FOCUS=false

# Nombre de tentatives en cas d'échec
VITE_QUERY_RETRY=1

# ====================
# Services Externes (Optionnel)
# ====================
# URL du service de stockage de fichiers
# VITE_STORAGE_URL=http://localhost:4000

# URL WebSocket pour les notifications temps réel
# VITE_WEBSOCKET_URL=ws://localhost:3000

# ====================
# Monitoring & Analytics (Optionnel)
# ====================
# Sentry DSN pour le tracking d'erreurs
# VITE_SENTRY_DSN=

# Google Analytics ID
# VITE_GA_TRACKING_ID=
