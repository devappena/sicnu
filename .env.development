# Variables d'environnement pour le développement
# NE PAS committer ce fichier avec de vraies valeurs sensibles

# ====================
# Configuration API
# ====================
# URL de l'API backend
VITE_API_BASE_URL=http://localhost:3000/api

# Environnement
VITE_APP_ENV=development

# Délai de timeout des requêtes API (ms)
VITE_API_TIMEOUT=30000

# Activer les logs de l'API (requêtes/réponses)
VITE_ENABLE_API_LOGGING=true

# ====================
# Configuration Authentication
# ====================
# Clés de stockage des tokens
VITE_TOKEN_STORAGE_KEY=sicnu-auth-token
VITE_REFRESH_TOKEN_KEY=sicnu-refresh-token

# Durée de validité du token (ms) - 1 heure
VITE_TOKEN_EXPIRATION=3600000

# ====================
# Configuration React Query
# ====================
# Activer les DevTools React Query
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true

# Temps avant qu'une donnée soit considérée comme périmée (ms) - 1 minute
VITE_QUERY_STALE_TIME=60000

# Temps de conservation en cache (ms) - 5 minutes
VITE_QUERY_CACHE_TIME=300000

# Réactualiser au focus de la fenêtre
VITE_REFETCH_ON_FOCUS=false

# Nombre de tentatives en cas d'échec
VITE_QUERY_RETRY=1

# ====================
# Services Externes (Optionnel)
# ====================
# URL du service de stockage de fichiers
# VITE_STORAGE_URL=http://localhost:4000

# URL WebSocket pour les notifications temps réel
# VITE_WEBSOCKET_URL=ws://localhost:3000
