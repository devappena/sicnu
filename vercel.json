{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/auth/[...rest].js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/employees/[...rest].js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    }
  }
}
